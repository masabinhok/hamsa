# Groq (free tier, open-weight models only: gpt-oss-120b / Qwen)
GROQ_API_KEY=
REASONING_MODEL=openai/gpt-oss-120b
# Optional: Google Fact Check Tools, finds fact-checks published abroad (ADR 0012)
FACT_CHECK_API_KEY=
# Optional self-hosted web search (docker compose service "searxng"); unset skips web evidence
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=
# Local Ollama
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen3-vl:8b-instruct
EMBEDDING_MODEL=bge-m3
# Vector store
QDRANT_URL=http://localhost:6333
# Browser whose login yt-dlp borrows to fetch pasted Facebook/TikTok links (ADR 0010)
FETCH_BROWSER=firefox
# Optional operator key; checkers use their own codes (python -m app.checkers add NAME)
DESK_TOKEN=
# The public site's address; report links sent by the Telegram bot point here
FRONTEND_ORIGIN=http://localhost:3000
# Optional Telegram bot, from @BotFather (python -m app.telegram)
TELEGRAM_BOT_TOKEN=
