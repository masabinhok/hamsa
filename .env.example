# Groq (free tier, open-weight models only: gpt-oss-120b / Qwen)
GROQ_API_KEY=
REASONING_MODEL=openai/gpt-oss-120b
# Local Ollama
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen3-vl:8b-instruct
EMBEDDING_MODEL=bge-m3
# Vector store
QDRANT_URL=http://localhost:6333
# Browser whose login yt-dlp borrows to fetch pasted Facebook/TikTok links (ADR 0010)
FETCH_BROWSER=firefox
# Checker desk API token (desk endpoints are disabled while empty)
DESK_TOKEN=
FRONTEND_ORIGIN=http://localhost:3000
